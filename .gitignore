/target
**/target
Cargo.lock

# credentials are machine-local; provide only deliberately redacted examples
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# maintainer-local desktop launchers stay on the release machine.
# `release-thaum-painter` is tracked: it is the reproducible public-release
# contract and reads credentials only from the machine-local GitHub seam.
/orchestration/build-commands/*.desktop

# build-commands cargo cache + built binaries (never version these)
orchestration/builds/

# runtime output (never version these)
artifacts/painter-files/
orchestration/artifacts/
artifacts/debug-logging/
artifacts/autosave/

# stray save-test outputs at repo root
/file1
/file2
/file3
/'file1
context/debug-logging/
