#!/usr/bin/env bash
# release-thaum-painter — publish one deliberate public Thaum Painter release.
#
# A release always builds all three platforms on GitHub from exact pushed
# painter + renderer commits. After GitHub publishes the release, this command
# publishes the canonical website's displayed version and release manifest
# only after GitHub has made all three platform assets public.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
painter_root="$(cd "$script_dir/../.." && pwd)"
renderer_root="$(cd "$painter_root/../thaum-renderer" && pwd)"
website_root="${THAUM_PAINTER_WEBSITE_ROOT:-$HOME/Repos/jartanddesign-website}"
github_repo="jkennedy1998/thaum-painter"
website_entry="source/thaum-painter/2026/1/entry.md"
website_manifest="thaum-painter/release.json"
website_generated_entries="source/thaum-painter/entries.js"
github_cli="${JOBO_GITHUB_CLI:-/jobo/tools/github/run-github-cli.mjs}"
github_git_cli="${JOBO_GITHUB_GIT_CLI:-/jobo/tools/github/run-git-with-github-auth.mjs}"

github() {
  node "$github_cli" "$@"
}

github_git() {
  node "$github_git_cli" "$@"
}

fail() {
  echo "error: $*" >&2
  exit 1
}

require_clean_pushed_main() {
  local repo_root="$1" label="$2" branch="${3:-main}"
  git -C "$repo_root" diff --quiet || fail "$label has unstaged changes; commit or stash them before releasing"
  git -C "$repo_root" diff --cached --quiet || fail "$label has staged changes; commit them before releasing"
  [[ -z "$(git -C "$repo_root" ls-files --others --exclude-standard)" ]] || fail "$label has untracked files; commit, ignore, or remove them before releasing"
  git -C "$repo_root" fetch origin "$branch" --quiet
  local local_sha remote_sha
  local_sha="$(git -C "$repo_root" rev-parse HEAD)"
  remote_sha="$(git -C "$repo_root" rev-parse "origin/$branch")"
  [[ "$local_sha" == "$remote_sha" ]] || fail "$label HEAD is not the pushed origin/$branch commit; push it before releasing"
  printf '%s\n' "$local_sha"
}

find_workflow_run() {
  local started_at="$1" painter_sha="$2"
  local run_id=""
  for _ in $(seq 1 30); do
    run_id="$(github run list --repo "$github_repo" --workflow release-thaum-painter.yml --event workflow_dispatch --limit 30 \
      --json databaseId,createdAt,headSha --jq ".[] | select(.createdAt >= \"$started_at\" and .headSha == \"$painter_sha\") | .databaseId" | head -n 1)"
    [[ -n "$run_id" ]] && {
      printf '%s\n' "$run_id"
      return 0
    }
    sleep 2
  done
  fail "GitHub accepted the release dispatch but no matching run appeared"
}

verify_release_assets() {
  local expected asset_names
  asset_names="$(github release view "$version" --repo "$github_repo" --json assets --jq '.assets[].name')"
  for expected in thaum-painter-linux.tar.gz thaum-painter-windows.zip thaum-painter-mac.zip; do
    grep -Fqx "$expected" <<<"$asset_names" \
      || fail "GitHub Release $version is missing expected asset: $expected"
  done
}

publish_website_release_facts() {
  [[ -d "$website_root/.git" ]] || fail "website repo is missing at $website_root"
  local website_sha
  website_sha="$(require_clean_pushed_main "$website_root" "jartanddesign-website" master)"
  local entry_path="$website_root/$website_entry"
  local manifest_path="$website_root/$website_manifest"
  [[ -f "$entry_path" ]] || fail "website entry is missing: $entry_path"
  [[ -f "$manifest_path" ]] || fail "website manifest is missing: $manifest_path"
  local release_notes
  release_notes="$(github release view "$version" --repo "$github_repo" --json body --jq .body)"
  [[ -n "$release_notes" ]] || fail "GitHub Release $version has no generated release notes"

  RELEASE_NOTES="$release_notes" python3 - "$entry_path" "$manifest_path" "$version" <<'PY'
from pathlib import Path
import json
import os
import re
import sys

entry_path = Path(sys.argv[1])
manifest_path = Path(sys.argv[2])
release_tag = sys.argv[3]
release_notes = os.environ["RELEASE_NOTES"].strip()
entry = entry_path.read_text()
entry, count = re.subn(r'(?m)^v[0-9]+\.[0-9]+\.[0-9]+(?=\s*·)', release_tag, entry, count=1)
if count != 1:
    raise SystemExit("expected exactly one displayed version in the Thaum Painter website entry")
entry, count = re.subn(
    r'(?ms)^## release notes\n.*?(?=^## preset\n)',
    lambda _: f"## release notes\n{release_notes}\n\n",
    entry,
    count=1,
)
if count != 1:
    raise SystemExit("expected exactly one release-notes section before the Thaum Painter preset")
for platform, suffix in (("linux", "tar.gz"), ("windows", "zip"), ("mac", "zip")):
    # These permanent latest-release URLs intentionally stay stable; validate
    # all three instead of allowing the release page to drift from its assets.
    url = f"https://github.com/jkennedy1998/thaum-painter/releases/latest/download/thaum-painter-{platform}.{suffix}"
    if entry.count(url) != 1:
        raise SystemExit(f"expected exactly one {platform} latest-release link in the Thaum Painter entry")
entry_path.write_text(entry)
manifest_path.write_text(json.dumps({
    "version": release_tag.removeprefix("v"),
    "page": "https://jartanddesign.com/thaum-painter/",
}, indent=2) + "\n")
PY
  (
    cd "$website_root"
    node build-entries.mjs
  )
  if git -C "$website_root" diff --quiet -- "$website_entry" "$website_manifest" "$website_generated_entries"; then
    echo "website already publishes $version"
    return 0
  fi
  git -C "$website_root" add "$website_entry" "$website_manifest" "$website_generated_entries"
  git -C "$website_root" commit -m "Thaum Painter: publish $version"
  github_git -C "$website_root" push origin master
  echo "published website release facts from ${website_sha:0:12}"
}

version="${1:-}"
if [[ -z "$version" && -t 0 ]]; then
  read -r -p 'Release version (for example v0.1.2): ' version
fi
[[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "release version must be vMAJOR.MINOR.PATCH (for example v0.1.2)"
package_version="$(python3 - "$painter_root/orchestration/build-commands/Cargo.toml" <<'PY'
import sys
import tomllib
with open(sys.argv[1], "rb") as source:
    print(tomllib.load(source)["package"]["version"])
PY
)"
[[ "v$package_version" == "$version" ]] || fail "release version $version does not match thaum-painter-entrypoint package version v$package_version"
[[ -f "$github_cli" && -f "$github_git_cli" ]] || fail "releasing requires the jobo GitHub seam under /jobo/tools/github/"
github auth status -h github.com >/dev/null 2>&1 || fail "releasing requires GITHUB_TOKEN in jobo runtime secrets"

painter_sha="$(require_clean_pushed_main "$painter_root" "thaum-painter")"
renderer_sha="$(require_clean_pushed_main "$renderer_root" "thaum-renderer")"
git -C "$painter_root" show-ref --verify --quiet "refs/tags/$version" && fail "local tag $version already exists"
git -C "$painter_root" ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1 && fail "remote tag $version already exists"

git -C "$painter_root" tag -a "$version" "$painter_sha" -m "Thaum Painter $version"
github_git -C "$painter_root" push origin "$version"

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "requesting public $version release for painter ${painter_sha:0:12} and renderer ${renderer_sha:0:12}"
github workflow run release-thaum-painter.yml --repo "$github_repo" --ref main \
  -f version="$version" -f painter_ref="$painter_sha" -f renderer_ref="$renderer_sha"
run_id="$(find_workflow_run "$started_at" "$painter_sha")"
echo "waiting for GitHub Actions release run $run_id"
github run watch "$run_id" --repo "$github_repo" --exit-status

github release view "$version" --repo "$github_repo" --json url --jq .url >/dev/null || fail "release workflow completed but GitHub Release $version is unavailable"
verify_release_assets
publish_website_release_facts
printf 'public release: '
github release view "$version" --repo "$github_repo" --json url --jq .url
