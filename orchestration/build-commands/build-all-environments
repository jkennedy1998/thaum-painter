#!/usr/bin/env bash
# build-all-environments — rebuild painter distribution lanes.
#
# Linux and Windows build locally. Mac is built on GitHub's macOS runner from
# the exact pushed painter + renderer commits, then downloaded into the local
# mac lane. No build command publishes a GitHub Release or changes the site.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
painter_root="$(cd "$script_dir/../.." && pwd)"
renderer_root="$(cd "$painter_root/../thaum-renderer" && pwd)"
builds_root="$painter_root/orchestration/builds"
cargo_cache="$builds_root/.cargo-cache"
lane_name="thaum painter"
github_repo="jkennedy1998/thaum-painter"
github_cli="${JOBO_GITHUB_CLI:-/jobo/tools/github/run-github-cli.mjs}"

github() {
  node "$github_cli" "$@"
}

source "$HOME/.cargo/env" 2>/dev/null || true
cd "$painter_root"

fail() {
  echo "error: $*" >&2
  exit 1
}

assemble_lane() {
  local lane_dir="$1" built_exe="$2" exe_name="$3"
  rm -rf "$lane_dir"
  mkdir -p "$lane_dir"
  cp "$built_exe" "$lane_dir/$exe_name"
  cp -r "$renderer_root/orchestration/renderer-assets" "$lane_dir/renderer-assets"
  cp "$painter_root/context/LICENSE.md" "$lane_dir/LICENSE"
  cp "$renderer_root/context/LICENSE.md" "$lane_dir/RENDERER-LICENSE"
  echo "built: $lane_dir"
}

build_linux() {
  cargo build --release -p thaum-painter-entrypoint
  assemble_lane "$builds_root/linux/$lane_name" \
    "$cargo_cache/release/thaum-painter-entrypoint" "thaum painter"
}

build_windows() {
  cargo build --release --target x86_64-pc-windows-gnu -p thaum-painter-entrypoint
  assemble_lane "$builds_root/windows/$lane_name" \
    "$cargo_cache/x86_64-pc-windows-gnu/release/thaum-painter-entrypoint.exe" "thaum painter.exe"
}

# Internal CI-only lane builder. A Linux invocation must use build_mac(), which
# verifies pushed source and asks GitHub's macOS runner for the binary.
build_mac_local() {
  [[ "$(uname -s)" == Darwin ]] || fail "mac-local only runs on macOS CI"
  cargo build --release -p thaum-painter-entrypoint
  assemble_lane "$builds_root/mac/$lane_name" \
    "$cargo_cache/release/thaum-painter-entrypoint" "thaum painter"
}

require_clean_pushed_main() {
  local repo_root="$1" label="$2" branch="main"
  git -C "$repo_root" diff --quiet || fail "$label has unstaged changes; commit or stash them before building Mac"
  git -C "$repo_root" diff --cached --quiet || fail "$label has staged changes; commit them before building Mac"
  [[ -z "$(git -C "$repo_root" ls-files --others --exclude-standard)" ]] || fail "$label has untracked files; commit, ignore, or remove them before building Mac"
  git -C "$repo_root" fetch origin "$branch" --quiet
  local local_sha remote_sha
  local_sha="$(git -C "$repo_root" rev-parse HEAD)"
  remote_sha="$(git -C "$repo_root" rev-parse "origin/$branch")"
  [[ "$local_sha" == "$remote_sha" ]] || fail "$label HEAD is not the pushed origin/$branch commit; push it before building Mac"
  printf '%s\n' "$local_sha"
}

find_workflow_run() {
  local workflow="$1" started_at="$2" painter_sha="$3"
  local run_id=""
  for _ in $(seq 1 30); do
    run_id="$(github run list --repo "$github_repo" --workflow "$workflow" --event workflow_dispatch --limit 30 \
      --json databaseId,createdAt,headSha --jq ".[] | select(.createdAt >= \"$started_at\" and .headSha == \"$painter_sha\") | .databaseId" | head -n 1)"
    [[ -n "$run_id" ]] && {
      printf '%s\n' "$run_id"
      return 0
    }
    sleep 2
  done
  fail "GitHub accepted the workflow dispatch but no matching run appeared"
}

build_mac() {
  [[ -f "$github_cli" ]] || fail "building Mac requires the jobo GitHub seam at $github_cli"
  github auth status -h github.com >/dev/null 2>&1 || fail "building Mac requires GITHUB_TOKEN in jobo runtime secrets"

  local painter_sha renderer_sha started_at run_id temp_dir artifact_zip
  painter_sha="$(require_clean_pushed_main "$painter_root" "thaum-painter")"
  renderer_sha="$(require_clean_pushed_main "$renderer_root" "thaum-renderer")"
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "requesting Mac build for painter ${painter_sha:0:12} and renderer ${renderer_sha:0:12}"
  github workflow run build-mac.yml --repo "$github_repo" --ref main \
    -f painter_ref="$painter_sha" -f renderer_ref="$renderer_sha"
  run_id="$(find_workflow_run build-mac.yml "$started_at" "$painter_sha")"
  echo "waiting for GitHub Actions run $run_id"
  github run watch "$run_id" --repo "$github_repo" --exit-status

  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' RETURN
  github run download "$run_id" --repo "$github_repo" --name thaum-painter-mac --dir "$temp_dir"
  artifact_zip="$(find "$temp_dir" -maxdepth 1 -type f -name 'thaum-painter-mac.zip' -print -quit)"
  [[ -n "$artifact_zip" ]] || fail "Mac workflow completed without thaum-painter-mac.zip"
  rm -rf "$builds_root/mac"
  mkdir -p "$builds_root/mac"
  unzip -q "$artifact_zip" -d "$builds_root/mac"
  [[ -x "$builds_root/mac/$lane_name/$lane_name" ]] || fail "downloaded Mac lane is missing its executable"
  echo "built: $builds_root/mac/$lane_name"
}

usage() {
  cat <<'EOF'
Usage: build-all-environments [linux] [windows] [mac]

No arguments rebuilds all three lanes. Mac requires both thaum-painter and
thaum-renderer to be clean and exactly pushed to origin/main; it runs remotely
on GitHub Actions and is downloaded into orchestration/builds/mac/.
EOF
}

platforms=("$@")
((${#platforms[@]})) || platforms=(linux windows mac)
for platform in "${platforms[@]}"; do
  case "$platform" in
    linux) build_linux ;;
    windows) build_windows ;;
    mac) build_mac ;;
    mac-local) build_mac_local ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; fail "unknown environment: $platform" ;;
  esac
done
